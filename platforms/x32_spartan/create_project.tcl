# AES67 core: all files come from the AES67 repository. The MAC IO files in ethernet_mac/intel
# are plain VHDL without vendor primitives, they are used for every FPGA family here.
set aes67_sources {
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/intel/utility.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/intel/single_signal_synchronizer.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/intel/mii_gmii_io.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/reverse_mac.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/eth_ram.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/crc.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/crc32.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/ethernet.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/ethernet_types.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/framing.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/framing_common.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/mii_gmii.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/miim.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/miim_control.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/miim_registers.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/miim_types.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_mac/reset_generator.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_packet_parser.vhd
	ext/AES67/FPGA/FPGA_Ethernet/FPGA/ethernet_receive.vhd
	ext/AES67/FPGA/aes67_top.vhd
	ext/AES67/FPGA/aes67_wb_bridge.vhd
	ext/AES67/FPGA/audio_rx/rx_ringbuffer.vhd
	ext/AES67/FPGA/audio_tx/audio_tx_module.vhd
	ext/AES67/FPGA/audio_tx/tx_router.vhd
	ext/AES67/FPGA/audio_tx/tx_sample_buffer.vhd
	ext/AES67/FPGA/audio_tx/tx_transmitter.vhd
