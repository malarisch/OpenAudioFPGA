}

# the AES67 checkout can be somewhere else (e.g. inside a VM): AES67_DIR=<path>
if {[info exists ::env(AES67_DIR)]} {
	set mapped {}
	foreach f $aes67_sources {
		if {[string match "ext/AES67/*" $f]} {
			lappend mapped [file join $::env(AES67_DIR) [string range $f 10 end]]
		} else {
			lappend mapped $f
		}
	}
	set aes67_sources $mapped
}

set do_build [expr {[lsearch -exact $argv build] >= 0}]

# With or without AES67 core: the default of the generic G_AES67 in x32_spartan.vhd
# decides (as on Lattice), the arguments aes67 / noaes67 override it. The AES67
# sources are added exactly when the core is built, so that XST cannot silently
# turn it into a black box (which only fails later, in NGDBuild).
set fh [open [file join $here x32_spartan.vhd]]
set top_vhd [read $fh]
close $fh
if {![regexp -nocase {G_AES67\s*:\s*boolean\s*:=\s*(true|false)} $top_vhd -> aes67_default]} {
	error "create_project.tcl: no default of G_AES67 found in x32_spartan.vhd"
}
set with_aes67 [string equal -nocase $aes67_default true]
if {[lsearch -exact $argv aes67] >= 0}   { set with_aes67 1 }
if {[lsearch -exact $argv noaes67] >= 0} { set with_aes67 0 }

if {$with_aes67} {
	set missing {}
	foreach f $aes67_sources {
		if {![file exists [file join $root $f]]} { lappend missing $f }
	}
	if {[llength $missing] > 0} {
		error "create_project.tcl: AES67 core requested, but [llength $missing] of its sources are missing,\
			first: [lindex $missing 0]\n(ext/AES67 is not a checkout visible here; set AES67_DIR=<checkout>,\
			or build without the core: argument noaes67 / G_AES67 := false)"
	}
}
puts "create_project.tcl: G_AES67 = [expr {$with_aes67 ? "true" : "false"}]"

file mkdir [file join $here build]
cd [file join $here build]

if {[file exists x32_spartan.xise]} {
	project open x32_spartan.xise
} else {
	project new x32_spartan.xise
	project set family "Spartan3A and Spartan3AN"
	project set device xc3s1400a
	project set package ft256
	project set speed -4
	project set top_level_module_type "HDL"
	project set synthesis_tool "XST (VHDL/Verilog)"
	project set "Preferred Language" "VHDL"

	foreach f $sources {
		xfile add [file join $root $f]
	}
	if {$with_aes67} {
		foreach f $aes67_sources {
			xfile add [file join $root $f]
		}
	}
	# always explicit, so that an override of the VHDL default reaches XST
	project set "Generics, Parameters" "G_AES67=[expr {$with_aes67 ? "true" : "false"}]" -process "Synthesize - XST"
	project set top "rtl" "x32_spartan"

	# settings of the previous OpenX32 project
	project set "Optimization Effort" "High" -process "Synthesize - XST"
	project set "Max Fanout" "100000" -process "Synthesize - XST"
	project set "Perform Timing-Driven Packing and Placement" "true" -process "Map"
	project set "Unused IOB Pins" "Float" -process "Generate Programming File"
	project set "Drive Done Pin High" "true" -process "Generate Programming File"
	project set "Enable Internal Done Pipe" "true" -process "Generate Programming File"
	project set "UserID Code (8 Digit Hexadecimal)" "0x0F321C32" -process "Generate Programming File"
}

if {$do_build} {
	process run "Generate Programming File"
}

project close
