	rtl/core/audiomatrix_ram_write.vhd
	rtl/core/tdm_multichan_rx.vhd
	rtl/core/tdm_multichan_tx.vhd
	rtl/core/routing_wb.vhd
	rtl/core/aes50_rst.vhd
	rtl/core/openaudio_core.vhd
	litex_soc/build/xilinx/gateware/openaudio_soc.v
	rtl/periph/reset.vhd
	rtl/periph/spi_tx.vhd
	rtl/periph/spi_16bit_tx.vhd
	rtl/periph/cs2000cp_config.vhd
	rtl/periph/cs42438_config.vhd
	rtl/periph/m8000adc_config.vhd
	rtl/periph/pcm1690dac_config.vhd
	rtl/periph/uart_collector.vhd
	rtl/periph/tdm_demux.vhd
	rtl/periph/ultranet_tx.vhd
	consoles/x32/x32_common.vhd
	platforms/x32_spartan/ip/dcm1.vhd
	platforms/x32_spartan/ip/dcm2.vhd
	platforms/x32_spartan/ip/aes50_rmii_rxd.vhd
	platforms/x32_spartan/ip/aes50_rmii_txd.vhd
	platforms/x32_spartan/ip/oddr_clk.vhd
