# Creates the ISE project for the X32 with Spartan-3A (XC3S1400A-4FT256):
#
#   cd platforms/x32_spartan
#   xtclsh create_project.tcl          -> build/x32_spartan.xise (open it in ISE)
#   xtclsh create_project.tcl build    -> also runs the implementation up to the bit file
#   xtclsh create_project.tcl aes67    -> force the AES67 core on (noaes67: off); without
#                                         either, the default of G_AES67 in x32_spartan.vhd
#                                         decides. With the core it needs ext/AES67, or the
#                                         environment variable AES67_DIR=<checkout>
#   xtclsh create_project.tcl build aes67
#
# The source list is the same as in sim/sources.mk. litex_soc/build/xilinx/ is
# generated by litex_soc/generate.py (build.sh does that before the build).

set root [file normalize [file join [file dirname [info script]] .. ..]]
set here [file normalize [file dirname [info script]]]

