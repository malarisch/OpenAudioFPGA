BLOCK RESETPATHS ;
BLOCK ASYNCPATHS ;
VOLTAGE 1.045 V;
SYSCONFIG DONE_EX=OFF CONFIG_MODE=SLAVE_SERIAL CONFIG_IOVOLTAGE=3.3 WAKE_UP=21 INBUF=OFF MCCLK_FREQ=2.4 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=DISABLE SLAVE_PARALLEL_PORT=DISABLE ;
FREQUENCY 12.288000 MHz ;
FREQUENCY PORT "fpgaclk" 16.000000 MHz ;
FREQUENCY PORT "PLL_OUT" 49.152000 MHz ;
FREQUENCY NET "fpgaclk_c" 16.000000 MHz ;
FREQUENCY NET "PLL_OUT_c" 49.152000 MHz ;
FREQUENCY NET "clk_50MHz" 50.000000 MHz ;
FREQUENCY NET "CLKOS_0" 100.000000 MHz ;
USE PRIMARY NET "fpgaclk_c" ;
USE PRIMARY NET "PLL_OUT_c" ;
USE PRIMARY NET "clk_50MHz" ;
USE PRIMARY NET "CLKOS_0" ;
USE DIN TRUE CELL "b2v_inst_rmii_rxd/Inst2_IFS1P3DX0" ;
USE DIN TRUE CELL "b2v_inst_rmii_rxd/Inst2_IFS1P3DX1" ;
USE DIN TRUE CELL "b2v_inst_rmii_rxd/Inst2_IFS1P3DX2" ;
USE DOUT TRUE CELL "b2v_inst_rmii_txd/Inst3_OFS1P3DX0" ;
USE DOUT TRUE CELL "b2v_inst_rmii_txd/Inst3_OFS1P3DX1" ;
USE DOUT TRUE CELL "b2v_inst_rmii_txd/Inst3_OFS1P3DX2" ;
USE DOUT TRUE CELL "b2v_inst_aes50_clk/Inst4_ODDRX1F0" ;
# RMII TX to the LAN8720A (REF_CLK In mode: tsu 4.0 ns, tihold 1.5 ns). The PHY clock is the
# inverted clk_50MHz (ODDR "10"), so its rising edge is 10 ns after the data launch. Trace does
# not model that inversion: with CLKOUT PORT it reports a false hold violation, so the outputs
# are constrained against the internal clock only (launch + 6 ns leaves >= 4 ns setup).
CLOCK_TO_OUT PORT "aes50a_rmii_tx_en_out" MAX 6.000000 ns CLKNET "clk_50MHz" ;
CLOCK_TO_OUT PORT "aes50a_rmii_txd_0_out" MAX 6.000000 ns CLKNET "clk_50MHz" ;
CLOCK_TO_OUT PORT "aes50a_rmii_txd_1_out" MAX 6.000000 ns CLKNET "clk_50MHz" ;
# RMII RX from the LAN8720A: the IO registers capture on the FALLING edge of clk_50MHz (see
# ip/aes50_rmii_rxd). The PHY clock edge (= our falling edge + ~4.6 ns ODDR/pad delay) launches the
# data, valid 2 .. 14 ns later (RMII). Against the next falling edge: valid >= 1.0 ns before it,
# held >= 6.0 ns after it.
INPUT_SETUP PORT "aes50a_rmii_crs_dv_in" 1.000000 ns HOLD 6.000000 ns CLKNET "clk_50MHz" ;
INPUT_SETUP PORT "aes50a_rmii_rxd_0_in" 1.000000 ns HOLD 6.000000 ns CLKNET "clk_50MHz" ;
INPUT_SETUP PORT "aes50a_rmii_rxd_1_in" 1.000000 ns HOLD 6.000000 ns CLKNET "clk_50MHz" ;
INPUT_SETUP PORT "aes50b_rmii_crs_dv_in" 1.000000 ns HOLD 6.000000 ns CLKNET "clk_50MHz" ;
INPUT_SETUP PORT "aes50b_rmii_rxd_0_in" 1.000000 ns HOLD 6.000000 ns CLKNET "clk_50MHz" ;
INPUT_SETUP PORT "aes50b_rmii_rxd_1_in" 1.000000 ns HOLD 6.000000 ns CLKNET "clk_50MHz" ;
MAXDELAY NET "clk_50MHz" 10.000000 ns ;
MAXDELAY NET "CLKOS_0" 10.000000 ns ;
#
# ---- AES67 core (instance u_x32/u_core/gen_aes67.u_aes67), ported from AES67/FPGA/boards/altera/cyc2/cyc2.sdc ----
# sys_clk = clk_100MHz, LiteX bridge = clk_50MHz, VCXO/MCLK = PLL_OUT (clk_24_576MHz).
# CDC between those clocks is already blocked by the clock groups in openx32.sdc.
#
# RMII -> MII converter: register-divided 25 MHz MAC clock (cyc2: txclk_i/rxclk_i).
FREQUENCY NET "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/mii_tx_clock" 25.000000 MHz ;
# sys_clk (100 MHz) <-> MAC clock: only CDC-safe transfers cross here (RX timestamp is
# written right after SOF and latched at byte 23, SOF toggle goes through a 2-FF synchroniser).
# The clock groups of openx32.sdc do not cover this register-divided clock.
# Do NOT block clk_50MHz <-> mii_tx_clock: the RMII<->MII converter transfers are synchronous.
# (the 100 MHz net is called "CLKOS_0" after synthesis, "clk_100MHz" matches no clock net)
BLOCK PATH FROM CLKNET "CLKOS_0" TO CLKNET "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/mii_tx_clock" ;
BLOCK PATH FROM CLKNET "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/mii_tx_clock" TO CLKNET "CLKOS_0" ;
# RMII -> MII converter, RX data into the MAC: mac_mii_rxd/rxdv/rxer only change on the
# clk_50MHz edge where the divided MII clock FALLS, the MAC samples on its RISING edge
# (rmii_phy_if.v: "if(mac_mii_rxc)"). Real launch-to-capture distance is 20 ns in both
# directions; Trace assumes the same edge and reports a false hold violation (clock skew
# of the register-divided clock).
BLOCK PATH FROM CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/mii_converters_inst/rmiigen.rmii_phy_if_inst/mac_mii_rxd*" ;
BLOCK PATH FROM CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/mii_converters_inst/rmiigen.rmii_phy_if_inst/mac_mii_rxdv" ;
BLOCK PATH FROM CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/mii_converters_inst/rmiigen.rmii_phy_if_inst/mac_mii_rxer" ;
# Media clock multiplier: operand is latched and held for two cycles.
MULTICYCLE FROM CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/aes67_top_inst/ptp_inst/b2v_wallclock/u_media/media_clock_nsec_latch*" TO CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/aes67_top_inst/ptp_inst/b2v_wallclock/u_media/media_mult_reg*" 2.000000 X ;
# Quasi-static LiteX CSRs (written by the host, used in other clock domains).
BLOCK PATH FROM CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_soc_aes67_bridge_inst/aes67_csr_*storage*" ;
BLOCK PATH FROM CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_soc_aes67_bridge_inst/aes67soc_reset_storage*" ;
BLOCK PATH FROM CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_soc_aes67_bridge_inst/eth_buf_tx_len*storage*" ;
BLOCK PATH FROM CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_soc_aes67_bridge_inst/eth_buf_rx_ack*storage*" ;
# Ethernet buffer handshake: synchronised on the receiving side.
BLOCK PATH FROM CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_eth_buffer_bridge_inst/rx_valid_reg" ;
BLOCK PATH TO CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_soc_aes67_bridge_inst/eth_buf_rx_valid_meta*" ;
BLOCK PATH TO CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_soc_aes67_bridge_inst/eth_buf_rx_len_latched*" ;
BLOCK PATH FROM CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_eth_buffer_bridge_inst/rp_pub*" TO CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_eth_buffer_bridge_inst/rd_ptr_w*" ;
BLOCK PATH FROM CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_eth_buffer_bridge_inst/rp_req" TO CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_eth_buffer_bridge_inst/rp_req_meta" ;
BLOCK PATH FROM CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_eth_buffer_bridge_inst/wp_ack" TO CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_eth_buffer_bridge_inst/wp_ack_meta" ;
BLOCK PATH TO CELL "u_x32/u_core/gen_aes67.u_aes67/soc_top_inst/wb_bridge_top_inst/aes67_wb_bridge_inst/litex_eth_buffer_bridge_inst/tx_req_meta" ;

